# URL of the audit endpoint. Inlined at build time (fixed per build).
VITE_AUDIT_URL=http://localhost:8000/v1/audit
# Set to exactly "true" to use bundled fixtures instead of the network.
VITE_MOCK=true
# Eval API base URL. The local dev and preview proxy uses IAUDIT_EVAL_PORT (default 8100).
VITE_EVAL_API_BASE=/eval-api
