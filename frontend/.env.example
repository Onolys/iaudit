# URL of the audit endpoint. Inlined at build time (fixed per build).
VITE_AUDIT_URL=http://localhost:8000/v1/audit
# Set to exactly "true" to use bundled fixtures instead of the network.
VITE_MOCK=true
# Eval API base URL. The local dev and preview proxy uses IAUDIT_EVAL_PORT (default 8100).
VITE_EVAL_API_BASE=/eval-api
# Eval tab. Unset/anything but "false" = visible (local dev). `.env.production` sets "false" for the deployed build.
# VITE_EVAL_ENABLED=true
# Login gate (SP07 R2). Gate renders only when exactly "true" and VITE_MOCK is not "true". Unset for local dev.
# VITE_AUTH_REQUIRED=true
# Identity Platform web config (placeholders; supply per environment at build time). authDomain defaults to admin.onolys.com.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=admin.onolys.com
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
