# Names are the SP06 env-var interface. Local dev: copy to .env, export, run combined mode.
ENV=local                     # local|test|staging|prod
SERVICE_MODE=combined         # api|worker|combined
AUTH_MODE=fake                # fake (Bearer test:<uid>; only ENV=local|test) | idp
ADAPTERS=stub                 # stub|real
GCP_PROJECT=onolys
REGION=us-central1
FIRESTORE_DATABASE=(default)  # staging | (default)
AUTH_PROJECT=onolys
AUDIO_BUCKET=
CORS_ORIGINS=http://localhost:5173
DAILY_RUN_CAP=20
MAX_ACTIVE_RUNS=2
TASKS_QUEUE=
TASKS_SA=
WORKER_URL=
ROUTES_FILE=
DEFAULT_PRESET=
GIT_SHA=dev
