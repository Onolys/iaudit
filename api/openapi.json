{
  "components": {
    "schemas": {
      "ApiKeyCreated": {
        "properties": {
          "api_key": {
            "title": "Api Key",
            "type": "string"
          },
          "created": {
            "format": "date-time",
            "title": "Created",
            "type": "string"
          },
          "key_id": {
            "title": "Key Id",
            "type": "string"
          }
        },
        "required": [
          "key_id",
          "api_key",
          "created"
        ],
        "title": "ApiKeyCreated",
        "type": "object"
      },
      "ApiKeyInfo": {
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "created": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created"
          },
          "key_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Key Id"
          },
          "last_used_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          }
        },
        "required": [
          "active"
        ],
        "title": "ApiKeyInfo",
        "type": "object"
      },
      "ErrorDetailModel": {
        "properties": {
          "code": {
            "enum": [
              "invalid_json",
              "unsupported_media_type",
              "schema_violation",
              "empty_transcript",
              "empty_assessment",
              "duplicate_ids",
              "invalid_parameters",
              "body_too_large",
              "too_many_turns",
              "too_many_sections",
              "rate_limited",
              "not_found",
              "method_not_allowed",
              "cors_rejected",
              "request_rejected",
              "upstream_unavailable",
              "deadline_exceeded",
              "internal_error",
              "unauthenticated",
              "forbidden",
              "invalid_state",
              "unsupported_audio",
              "audio_too_long",
              "audio_too_large",
              "audio_unreadable",
              "no_speech",
              "speakers_not_separated",
              "transcription_failed",
              "rating_invalid",
              "daily_cap_reached",
              "conflict"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetailModel",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Body of every non-2xx response (docs/contracts/public/public-error-response.schema.json).",
        "properties": {
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetailModel"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "schema_version": {
            "const": "0.0.1",
            "default": "0.0.1",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "message",
          "details"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Healthz": {
        "properties": {
          "code_version": {
            "title": "Code Version",
            "type": "string"
          },
          "service_mode": {
            "title": "Service Mode",
            "type": "string"
          },
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service_mode",
          "code_version"
        ],
        "title": "Healthz",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "description": "`onolys_<id>_<secret>` (see /v1/api-key)",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      },
      "HTTPBearer": {
        "description": "Identity Platform ID token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Onolys API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/api-key": {
      "delete": {
        "operationId": "deleteApiKey",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Revoke the active key (idempotent)",
        "tags": [
          "api-key"
        ]
      },
      "get": {
        "operationId": "getApiKey",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Active key metadata",
        "tags": [
          "api-key"
        ]
      },
      "post": {
        "operationId": "createApiKey",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Create a key (revokes the current one); the secret is shown once",
        "tags": [
          "api-key"
        ]
      }
    },
    "/v1/healthz": {
      "get": {
        "operationId": "getHealthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Healthz"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Liveness (no auth)",
        "tags": [
          "system"
        ]
      }
    }
  }
}
