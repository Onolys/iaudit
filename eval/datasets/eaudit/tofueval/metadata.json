{
  "product": "eaudit",
  "name": "tofueval",
  "title": "TofuEval",
  "description": "Factual consistency of topic-focused dialogue summaries from MediaSum and MeetingBank. Each item is one summary, with source documents defining the dev/test split and clustering. Licensed source text is downloaded locally.",
  "dataset_version": "17555c5bfc27f95371fd82b2de7014d8e14e1024",
  "adapter_version": "1.0.0",
  "kind": "adapter",
  "item_unit": "summary",
  "gold_kind": "tofueval_summary_sentences",
  "splits": [
    {
      "name": "dev",
      "description": "Summaries from the 70 development source documents."
    },
    {
      "name": "test",
      "description": "Summaries from the 30 held-out source documents."
    }
  ],
  "default_split": "dev",
  "cluster_key": "source document",
  "license": {
    "name": "Mixed: MIT-0 (no-training note); MediaSum research use; MeetingBank CC BY-NC-ND 4.0",
    "redistributable": false,
    "contains_licensed_text": true
  },
  "data_required": true,
  "test_split_note": "Held-out test documents are intended for final evaluation. Use the dev split for prompt and adapter development; repeated test evaluation can compromise the holdout.",
