{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iaudit.local/schemas/compare.schema.json",
  "title": "iaudit eval run comparison (compare())",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_a", "run_b", "dataset", "warnings", "n_shared", "n_a_only",
               "n_b_only", "n_clusters_shared", "deltas", "disagreements"],
  "properties": {
    "schema_version": {"const": "0.0.1"},
    "run_a": {"type": "string", "minLength": 1},
    "run_b": {"type": "string", "minLength": 1},
    "dataset": {"type": "string", "minLength": 1},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "n_shared": {"$ref": "#/$defs/count"},
    "n_a_only": {"$ref": "#/$defs/count"},
    "n_b_only": {"$ref": "#/$defs/count"},
    "n_clusters_shared": {"$ref": "#/$defs/count"},
    "deltas": {"type": "array", "items": {"$ref": "#/$defs/delta"}},
    "disagreements": {"type": "array", "items": {"$ref": "#/$defs/disagreement"}}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "slice": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    },
    "side": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "n", "ci"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "n": {"$ref": "#/$defs/count"},
        "ci": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
          ]
        }
      }
    },
    "delta": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "level", "policy", "slice", "a", "b", "delta", "delta_ci",
                   "ci_status", "n_clusters"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "level": {"type": "string", "minLength": 1},
        "policy": {"enum": ["primary", "secondary", "none"]},
        "slice": {"$ref": "#/$defs/slice"},
        "a": {"$ref": "#/$defs/side"},
        "b": {"$ref": "#/$defs/side"},
        "delta": {"type": ["number", "null"]},
        "delta_ci": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
          ]
        },
        "ci_status": {"enum": ["ok", "few_clusters", "undefined"]},
        "n_clusters": {"$ref": "#/$defs/count"}
      }
    },
    "disagreement": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "cluster", "pairs"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "cluster": {"type": "string"},
        "pairs": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["level", "unit", "gold", "a", "b"],
            "properties": {
              "level": {"type": "string", "minLength": 1},
              "unit": {"type": "string"},
              "gold": {"type": "string"},
              "a": {"type": ["string", "null"]},
              "b": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
