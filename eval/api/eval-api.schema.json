    "Comparison": {
      "$defs": {
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "delta": {
          "additionalProperties": false,
          "properties": {
            "a": {
              "$ref": "#/$defs/side"
            },
            "b": {
              "$ref": "#/$defs/side"
            },
