            "delta": {
              "type": [
                "number",
                "null"
              ]
            },
            "delta_ci": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array"
                }
              ]
            },
            "level": {
              "minLength": 1,
              "type": "string"
            },
            "metric": {
              "minLength": 1,
              "type": "string"
            },
            "n_clusters": {
              "$ref": "#/$defs/count"
            },
            "policy": {
              "enum": [
                "primary",
                "secondary",
                "none"
              ]
            },
            "slice": {
              "$ref": "#/$defs/slice"
            }
          },
          "required": [
            "metric",
            "level",
            "policy",
            "slice",
            "a",
            "b",
            "delta",
            "delta_ci",
            "ci_status",
            "n_clusters"
          ],
          "type": "object"
        },
        "disagreement": {
          "additionalProperties": false,
          "properties": {
            "cluster": {
              "type": "string"
            },
            "item_id": {
              "minLength": 1,
              "type": "string"
            },
            "pairs": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "a": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "b": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "gold": {
                    "type": "string"
                  },
                  "level": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "unit": {
                    "type": "string"
                  }
                },
                "required": [
                  "level",
                  "unit",
                  "gold",
                  "a",
                  "b"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "item_id",
            "cluster",
            "pairs"
          ],
          "type": "object"
        },
        "side": {
          "additionalProperties": false,
          "properties": {
            "ci": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array"
                }
              ]
            },
            "n": {
              "$ref": "#/$defs/count"
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "value",
            "n",
            "ci"
          ],
          "type": "object"
        },
        "slice": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "type": "object"
        }
      },
      "$id": "https://iaudit.local/schemas/compare.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "minLength": 1,
          "type": "string"
        },
        "deltas": {
          "items": {
            "$ref": "#/$defs/delta"
          },
          "type": "array"
        },
        "disagreements": {
          "items": {
            "$ref": "#/$defs/disagreement"
          },
          "type": "array"
        },
        "n_a_only": {
          "$ref": "#/$defs/count"
        },
        "n_b_only": {
          "$ref": "#/$defs/count"
        },
        "n_clusters_shared": {
          "$ref": "#/$defs/count"
        },
        "n_shared": {
          "$ref": "#/$defs/count"
        },
        "run_a": {
          "minLength": 1,
          "type": "string"
        },
        "run_b": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "run_a",
        "run_b",
        "dataset",
        "warnings",
        "n_shared",
        "n_a_only",
        "n_b_only",
        "n_clusters_shared",
        "deltas",
        "disagreements"
      ],
      "title": "iaudit eval run comparison (compare())",
      "type": "object"
    },
