  "tips": [
    {
      "rank": 1,
      "item_id": "question",
      "observation": "Several prompts sit in one turn, which can make it hard for the client to know which to answer.",
      "quote": {
        "turn_id": "t11",
        "start": 102,
        "end": 185,
        "text": "How confident are you, from one to ten, that you can make three lunch walks happen?"
      },
      "alternative": "How confident are you that you can make three lunch walks happen?",
      "why_it_matters": "One clear question leaves room for the client's own answer."
    },
    {
      "rank": 2,
      "item_id": "sr",
      "observation": "A short repeat of what the client said earlier adds little new.",
      "quote": {
        "turn_id": "t8",
        "start": 113,
        "end": 142,
        "text": "You're tired in the evenings."
      },
      "alternative": "You're tired by evening, and still you found the energy for those Saturday walks.",
      "why_it_matters": "A reflection that adds meaning keeps the client exploring."
    },
    {
      "rank": 3,
      "item_id": "question",
      "observation": "A why question can sound like a challenge to the client's answer.",
      "quote": {
        "turn_id": "t13",
        "start": 0,
        "end": 26,
        "text": "Why a six and not a three?"
      },
      "alternative": "What gives you a six and keeps it from being lower?",
      "why_it_matters": "Open phrasing invites the client's own reasons for change."
    }
  ],
