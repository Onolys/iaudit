{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error-response.schema.json",
  "title": "ErrorResponse",
  "description": "Body the backend returns with any non-2xx status, schema 1.0.0. The message is shown to the reviewer as-is. An error body is never an audit.",
  "type": "object",
  "required": ["schema_version", "error"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "request_id": {
      "type": "string",
      "description": "Echo of the request id, when the backend could read it."
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "unsupported_version",
            "payload_too_large",
            "rate_limited",
            "internal_error",
            "unavailable",
            "other"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable. Plain text; shown as-is."
        }
      }
    }
  }
}
