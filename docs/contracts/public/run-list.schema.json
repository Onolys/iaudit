{
  "$defs": {
    "RunView": {
      "properties": {
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "code_version": {
          "title": "Code Version",
          "type": "string"
        },
        "ended": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "n_runs": {
          "title": "N Runs",
          "type": "integer"
        },
        "preset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preset"
        },
        "rating_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating Id"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "run_info": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Info"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "started": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "stt": {
          "anyOf": [
            {
              "$ref": "#/$defs/SttInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "run_id",
        "session_id",
        "status",
        "n_runs",
        "code_version",
        "attempts"
      ],
      "title": "RunView",
      "type": "object"
    },
    "SttInfo": {
      "properties": {
        "language": {
          "default": "",
          "title": "Language",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        }
      },
      "title": "SttInfo",
      "type": "object"
    }
  },
  "$id": "run-list.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/RunView"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "RunList",
  "type": "object"
}
